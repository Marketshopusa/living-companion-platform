{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-companion.local/contracts/identity/v1/errors",
  "title": "IdentityError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "validation_error",
        "forbidden",
        "not_found",
        "conflict",
        "timeout",
        "persistence_failure"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
